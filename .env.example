# AED Care 로컬 실행용 환경 변수 예시 — 실제 값은 .env에만 넣고 커밋하지 마세요.
# 복사: Copy-Item .env.example .env   (PowerShell)

# SafeMap 공공데이터 API 키 (데이터 적재 스크립트용)
SAFEMAP_SERVICE_KEY=

# Cloudflare D1 (서버 전용, 브라우저로 보내지 않음)
#  - CLOUDFLARE_API_TOKEN 권한: Account · D1 · Edit
#  - 세 값이 모두 없으면 지도는 'DB 설정 누락'으로 안내하고 공공 AED를 조회하지 않습니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 비워 두면 sync 스크립트가 'aedcare' DB를 만들고 자동으로 채웁니다
D1_DATABASE_ID=

# 로컬 서버
AEDCARE_HOST=127.0.0.1
AEDCARE_PORT=5500
# (선택) 공공 AED 캐시 위치. 기본값 .cache/
# AEDCARE_CACHE_DIR=
